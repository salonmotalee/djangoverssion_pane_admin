{
  "name": "madar-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests package.json package-lock.json tsconfig.json next.config.ts *.mjs",
    "format:check": "prettier --check src tests package.json package-lock.json tsconfig.json next.config.ts *.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-date-object": "^2.1.9",
    "react-dom": "19.3.0",
    "react-multi-date-picker": "4.5.2",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
